  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BehaviorManager
  planManager: {fileID: 795257994}
  questionData:
    questions:
    - questionID: BEH001
      topicID: 
      questionType: Frequency
      questionText: "\xBFCon qu\xE9 frecuencia comunicas claramente tus expectativas y prioridades?"
      options: []
      requiredLevelStatuses: []
      perceptionAlignments: []
      isActive: 1
    - questionID: BEH002
      topicID: 
      questionType: Context
      questionText: "\xBFEn qu\xE9 situaciones te resulta m\xE1s dif\xEDcil aplicar esta competencia?"
      options:
      - optionID: CTX001
        optionText: Cuando tengo demasiadas responsabilidades.
      - optionID: CTX002
        optionText: "Cuando debo tomar decisiones bajo presi\xF3n."
      - optionID: CTX003
        optionText: Cuando necesito coordinarme con otras personas.
      requiredLevelStatuses: []
      perceptionAlignments: []
      isActive: 1
    - questionID: BEH003
      topicID: 
      questionType: Consistency
      questionText: "\xBFQu\xE9 factor afecta m\xE1s tu capacidad para mantener este comportamiento?"
      options:
      - optionID: CON001
        optionText: La falta de tiempo.
      - optionID: CON002
        optionText: Las prioridades cambiantes.
      - optionID: CON003
        optionText: "La falta de seguimiento o h\xE1bitos establecidos."
      requiredLevelStatuses: []
      perceptionAlignments: []
      isActive: 1
